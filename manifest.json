{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.1",
  "default_locale": "zh_CN",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://ip-api.com/*"
  ],
  "commands": {
    "open_country_search": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "__MSG_cmdOpenPopupDescription__"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/countries.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
